{
  "name": "ssh-workspace",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && node --max-old-space-size=4096 ./node_modules/vite/bin/vite.js build",
    "preview": "vite preview",
    "tauri": "tauri",
    "sidecar-windows:stop": "powershell -NoProfile -Command \"Get-CimInstance Win32_Process | Where-Object { $_.ExecutablePath -like '*ssh-sidecar*' } | ForEach-Object { Stop-Process -Id $_.ProcessId -Force }\"",
    "sidecar-mac:stop": "pkill -f ssh-sidecar || true",
    "sidecar:build": "npm --prefix sidecar run build",
    "sidecar:package": "npm --prefix sidecar run package:host",
    "desktop-mac:dev": "npm run sidecar-mac:stop && npm run sidecar:package && tauri dev",
    "desktop-windows:dev": "npm run sidecar-windows:stop && npm run sidecar:package && tauri dev"
  },
  "dependencies": {
    "@monaco-editor/react": "^4.7.0",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2.7.1",
    "@tauri-apps/plugin-fs": "^2.5.1",
    "@tauri-apps/plugin-opener": "^2",
    "@tauri-apps/plugin-shell": "^2.3.5",
    "@tauri-apps/plugin-store": "^2.4.3",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/xterm": "^6.0.0",
    "lucide-react": "^1.24.0",
    "monaco-editor": "^0.55.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.18.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "typescript": "~5.8.3",
    "vite": "^7.0.4"
  }
}
